# Example vaultx.env - safe to commit
# Plain values pass through, vault: references are resolved at runtime

# Database configuration
DB_HOST=localhost
DB_PORT=5432
DB_NAME=myapp_production
DB_PASSWORD=vault:local/myapp/db_password

# API keys
API_KEY=vault:local/myapp/api_key
AWS_ACCESS_KEY_ID=vault:local/aws/access_key_id

# OAuth
OAUTH_TOKEN=vault:local/prod/oauth_token

# Plain values work too
LOG_LEVEL=info
DEBUG=false
